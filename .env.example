# Safe TEMPLATE only. Enter values in Railway > Variables, NEVER in GitHub files.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PRIVATE_ADMIN_PASSWORD
DATABASE_PATH=/data/agribank.db
PRODUCTION=true
# Browser key is not a secret but MUST be restricted by HTTP referrer + API in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=
